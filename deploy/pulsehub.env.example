# PulseHub 2.1 生产环境变量（NAS Docker 部署）
# 该文件含密钥，权限必须为 600，且不得提交到代码仓库。
# 复制为 pulsehub.env 后按环境填写；部署脚本会替换其中的 __XXX__ 占位符。

# ---- 应用 ----
PULSEHUB_APP_ENV=production
PULSEHUB_HOST=0.0.0.0
PULSEHUB_PORT=8000
# 业务时间使用的本地时区：影响月末/逾期/对账边界，改动要对齐历史数据
PULSEHUB_LOCAL_TZ=Asia/Shanghai
PULSEHUB_CORS_ORIGINS=http://__NAS_HOST__:6065

# ---- 数据库（NAS Docker 内既有 MySQL）----
PULSEHUB_DATABASE_URL=mysql+aiomysql://__MYSQL_USER__:__MYSQL_PASSWORD__@__NAS_HOST__:__MYSQL_PORT__/__MYSQL_DB__?charset=utf8mb4
PULSEHUB_DB_ECHO=false

# ---- 会话与令牌 ----
PULSEHUB_JWT_SECRET=__JWT_SECRET__
# 访问令牌有效期：30 分钟太短，每次打开都要续期；而续期要写库，
# NAS 磁盘被虚拟机/备份抢占时能卡 10 秒。改为 12 小时，一天最多续期两次。
PULSEHUB_ACCESS_TOKEN_MINUTES=720
PULSEHUB_REFRESH_TOKEN_DAYS=14
PULSEHUB_LOGIN_MAX_FAILURES=5
PULSEHUB_LOGIN_LOCK_MINUTES=5
# 反复失败时的锁定上限（5→10→20→40→60 分钟，封顶此值）
PULSEHUB_LOGIN_LOCK_MAX_MINUTES=60

# ---- 限流与真实 IP ----
# 账号锁定防「盯一个账号猛试」，限流防「换着用户名挨个试」与脚本刷接口。
# 如需临时关掉（例如压测）把 enabled 设为 false。
PULSEHUB_RATE_LIMIT_ENABLED=true
PULSEHUB_RATE_LIMIT_LOGIN_PER_MINUTE=10
PULSEHUB_RATE_LIMIT_API_PER_MINUTE=300
# 只有「直接对端」在这个范围内才采信 X-Forwarded-For（否则任何人都能伪造来源）。
# 默认 = 本机 + Docker 内网，覆盖「nginx → 后端」这一跳。
# 如果 nginx 与后端不在 Docker 内网（例如都用 host 网络），把它改成 nginx 所在网段；
# 注意不要填整个 192.168.0.0/16——局域网机器能伪造 X-Forwarded-For，让限流失效。
PULSEHUB_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ---- 密钥加密（生产必须显式提供 Fernet Key）----
PULSEHUB_ENCRYPTION_KEY=__ENCRYPTION_KEY__

# ---- 附件与备份（容器内路径，已由 compose 挂载到宿主）----
PULSEHUB_ATTACHMENT_DIR=/app/data/attachments
PULSEHUB_ATTACHMENT_MAX_MB=20
PULSEHUB_BACKUP_DIR=/app/data/backups
