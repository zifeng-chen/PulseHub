# FAM V2.1 生产环境变量（NAS Docker 部署）
# 该文件含密钥，权限必须为 600，且不得提交到代码仓库。
# 复制为 fam-v21.env 后按环境填写；部署脚本会替换其中的 __XXX__ 占位符。

# ---- 应用 ----
FAM_APP_ENV=production
FAM_HOST=0.0.0.0
FAM_PORT=8000
FAM_CORS_ORIGINS=http://__NAS_HOST__:18080

# ---- 数据库（NAS Docker 内既有 MySQL）----
FAM_DATABASE_URL=mysql+aiomysql://__MYSQL_USER__:__MYSQL_PASSWORD__@__NAS_HOST__:__MYSQL_PORT__/__MYSQL_DB__?charset=utf8mb4
FAM_DB_ECHO=false

# ---- 会话与令牌 ----
FAM_JWT_SECRET=__JWT_SECRET__
FAM_ACCESS_TOKEN_MINUTES=30
FAM_REFRESH_TOKEN_DAYS=14
FAM_LOGIN_MAX_FAILURES=5
FAM_LOGIN_LOCK_MINUTES=5

# ---- 密钥加密（生产必须显式提供 Fernet Key）----
FAM_ENCRYPTION_KEY=__ENCRYPTION_KEY__

# ---- 附件与备份（容器内路径，已由 compose 挂载到宿主）----
FAM_ATTACHMENT_DIR=/app/data/attachments
FAM_ATTACHMENT_MAX_MB=20
FAM_BACKUP_DIR=/app/data/backups
