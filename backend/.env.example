# FAM V2.1 环境变量模板（24 §1.1 三套环境相互隔离）
# 复制为 .env 后按环境修改；生产环境禁止使用默认口令与演示数据。

# ---- 应用 ----
FAM_APP_ENV=development            # development | testing | production
FAM_HOST=127.0.0.1
FAM_PORT=8000
FAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 ----
# 生产（产品首次启动向导固定 MySQL）：
# FAM_DATABASE_URL=mysql+aiomysql://fam_user:change_me@127.0.0.1:3306/fam?charset=utf8mb4
# 本地开发 / 自动化测试（可运行底座）：
FAM_DATABASE_URL=sqlite+aiosqlite:///./data/fam_dev.db
FAM_DB_ECHO=false

# ---- 会话与令牌 ----
FAM_JWT_SECRET=please-change-this-in-production
FAM_ACCESS_TOKEN_MINUTES=30
FAM_REFRESH_TOKEN_DAYS=14
FAM_LOGIN_MAX_FAILURES=5
FAM_LOGIN_LOCK_MINUTES=5

# ---- 密钥加密（生产必须显式提供，使用 Fernet Key）----
FAM_ENCRYPTION_KEY=

# ---- 附件与备份 ----
FAM_ATTACHMENT_DIR=./data/attachments
FAM_ATTACHMENT_MAX_MB=20
FAM_BACKUP_DIR=./data/backups
